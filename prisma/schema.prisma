generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum FoodGroupCategory {
  PRODUCE
  PROTEIN
  GRAIN
  DAIRY
  FLAVOR
  OTHER
}

enum PreferenceSource {
  ONBOARDING
  LEARNED
}

enum Difficulty {
  EASY
  MEDIUM
  INVOLVED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK // legacy value, no longer assignable via the app — kept so existing
  // enum rows/migrations don't break; superseded by TAPAS.
  TAPAS
}

enum EffortTier {
  WEEKNIGHT
  WEEKEND
  PROJECT
}

// User-facing dashboard control (distinct from Recipe.effortTier, which is
// admin-curated catalog data) — see UserPreferences.effortPreference and
// score.ts's EFFORT_MATCH_WEIGHT for how the two map onto each other.
enum EffortPreference {
  QUICK
  ANY
  PROJECT
}

enum AllergenReviewStatus {
  UNVERIFIED
  VERIFIED
}

enum InteractionType {
  IMPRESSION
  OPEN
  DISMISS
  MUTE
  COOK
  STAR
  UNSTAR
  COSIGN
}

enum CooldownReason {
  SHOWN
  DISMISSED
  COOKED
  MUTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Core ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable: users created via Google/Apple sign-in have no password at
  // all. The Credentials provider's authorize() guards against this (see
  // src/auth.ts) — such accounts can only sign in via their OAuth provider.
  passwordHash String?
  name         String
  image        String?
  // Nullable: OAuth providers (especially Apple) often don't supply
  // city/country. Only the credentials /api/signup route still requires
  // this at creation time; it's otherwise just a profile detail (see
  // src/app/profile, src/app/admin/users — both already tolerate missing
  // values).
  country      String?
  city         String?
  timezone     String?
  birthday     DateTime?
  isAdmin      Boolean  @default(false)
  isPremium    Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // Provider account ids for adapter-less OAuth linking (no Account/Session
  // models in this schema — NextAuth is JWT-only here). Populated the first
  // time a user completes Google/Apple sign-in; see the jwt callback in
  // src/auth.ts for the find-or-create/link logic.
  googleId String? @unique
  appleId  String? @unique

  preferences         UserPreferences?
  foodGroupPreferences FoodGroupPreference[]
  interactions        Interaction[]
  cookLogs            CookLog[]
  cooldowns           Cooldown[]
  servedCards         ServedCard[]
  savedRecipes        SavedRecipe[]
  passwordResetTokens PasswordResetToken[]
  recipeSubmissions   RecipeSubmission[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  diets            Diet[]
  allergens        Allergen[]
  customAllergens  String[] @default([])

  favoriteCuisines   String[] @default([])
  foodGroupFeedback  String?

  // Free-tier feed intelligence v1: last-chosen Quick/Any/Project segmented
  // control on the dashboard, persisted so it becomes the default across
  // sessions. Soft signal only (see score.ts) — never excludes recipes on
  // its own, so a thin PROJECT inventory still fills gracefully.
  effortPreference EffortPreference @default(ANY)
  // Near-hard ceiling on Recipe.spiceLevel (0-3). Null = Hot / unfiltered —
  // matches spiceLevel's own "unknown = unfiltered" convention (see Recipe).
  // This is a comfort preference, not a safety filter, so it lives here
  // rather than alongside the hard allergen fields.
  spiceMax         Int?

  updatedAt DateTime @updatedAt
}

model FoodGroupPreference {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodGroupId   String
  foodGroup     FoodGroup        @relation(fields: [foodGroupId], references: [id], onDelete: Cascade)
  declaredValue Int // 0-100, immutable snapshot from onboarding
  learnedValue  Int // 0-100, drifts from behavior
  source        PreferenceSource @default(ONBOARDING)
  updatedAt     DateTime         @updatedAt

  @@unique([userId, foodGroupId])
}

model FoodGroup {
  id          String             @id @default(cuid())
  name        String             @unique
  category    FoodGroupCategory
  description String

  foodGroupPreferences FoodGroupPreference[]
  recipeProfiles       RecipeFoodGroup[]
}

model Diet {
  id   String @id @default(cuid())
  name String @unique

  userPreferences UserPreferences[]
  recipes         Recipe[]
  submissions     RecipeSubmission[] @relation("SubmissionDietTags")
}

model Allergen {
  id   String @id @default(cuid())
  name String @unique

  userPreferences UserPreferences[]
  recipes         Recipe[]
  submissions     RecipeSubmission[] @relation("SubmissionAllergenTags")
}

model Cuisine {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  recipes     Recipe[]
  submissions RecipeSubmission[]
}

// Admin-editable catalog of recipe "attribute" tags (e.g. "High protein",
// "Grilled") — mirrors Cuisine's {name, code} shape so it can reuse the
// same admin CatalogSection UI/API pattern. `code` is the stable machine
// identifier (e.g. "HIGH_PROTEIN"), auto-derived from `name` the same way
// Cuisine derives `slug` from `name`.
model AttributeTag {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  recipes Recipe[]
}

// ---------- Recipes ----------

model Recipe {
  id          String @id @default(cuid())
  slug        String @unique
  title       String

  shortDescription String
  note             String
  introCopy        String

  servings     Int
  prepMinutes  Int
  cookMinutes  Int
  difficulty   Difficulty
  cuisineId    String
  cuisine      Cuisine    @relation(fields: [cuisineId], references: [id])
  // Every recipe belongs to exactly one category (audited 2026-08 — see
  // git history for the one-off audit script). Previously a `MealSlot[]`
  // array allowing multiple slots per recipe; changed to a single required
  // value so breakfast/tapas/lunch/dinner are mutually exclusive.
  mealSlot     MealSlot
  effortTier   EffortTier
  batchFriendly Boolean @default(false)

  // 0-3 heat level, nullable. Unknown/untagged stays null and is always
  // treated as unfiltered by UserPreferences.spiceMax (a comfort
  // preference, not a safety filter — unlike allergenTags, an unrated
  // recipe is never assumed hot). `spiceLevelInferred` flags rows seeded by
  // scripts/backfill-spice-level.mjs from the existing "Chilli & heat"
  // RecipeFoodGroup weight rather than reviewed/authored directly, so admin
  // tooling can surface them for a manual pass later.
  spiceLevel         Int?
  spiceLevelInferred Boolean @default(false)

  attributeTags AttributeTag[]
  heroColor  String
  imageUrl   String?
  imageCredit String?

  // Simple, optional per-serving macros. Kept intentionally minimal — no
  // full nutrition-tracking system. Protein/carbs/fat/fiber/cholesterol are
  // gated behind User.isPremium in the UI; calories stay free for everyone.
  caloriesPerServing Int?
  proteinGrams       Int?
  carbsGrams         Int?
  fatGrams           Int?
  fiberGrams         Int?
  cholesterolMg      Int?

  allergenReviewStatus AllergenReviewStatus @default(UNVERIFIED)
  isActive             Boolean              @default(true)
  // Why this recipe is currently inactive/archived (e.g. "High fat/calories"),
  // shown in the admin Archive view. Null for recipes that were never
  // archived, or for pre-existing isActive:false rows from before this field
  // existed (they just show no reason, same as other nullable backfills).
  archivedReason       String?
  createdAt            DateTime             @default(now())

  ingredients      Ingredient[]
  steps            Step[]
  foodGroupProfile RecipeFoodGroup[]
  dietTags         Diet[]
  allergenTags     Allergen[]

  interactions     Interaction[]
  cookLogs         CookLog[]
  cooldowns        Cooldown[]
  servedCards      ServedCard[]
  savedBy          SavedRecipe[]
  cookbookEntries  CookbookRecipe[]
  submissionSource RecipeSubmission?
}

model Ingredient {
  id        String  @id @default(cuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  component String? // e.g. "For the sauce" grouping, null = main list
  order     Int
  quantity  String
  unit      String?
  item      String
  prepNote  String?
  optional  Boolean @default(false)
}

model Step {
  id              String  @id @default(cuid())
  recipeId        String
  recipe          Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order           Int
  text            String
  durationMinutes Int?
}

model RecipeFoodGroup {
  id          String    @id @default(cuid())
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodGroupId String
  foodGroup   FoodGroup @relation(fields: [foodGroupId], references: [id], onDelete: Cascade)
  weight      Int // 0-100

  @@unique([recipeId, foodGroupId])
}

// ---------- User-submitted recipes (pending review) ----------
// Kept structurally separate from Recipe so unreviewed/rejected content can
// never leak into the public catalog — dashboard/filter/cook-later/search
// queries only ever touch Recipe. Mirrors the Ingredient/Step pattern.

model RecipeSubmission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Same shape as Recipe's own input fields (mirrors recipeFieldsSchema)
  title            String
  shortDescription String
  note             String
  introCopy        String
  servings         Int
  prepMinutes      Int
  cookMinutes      Int
  difficulty       Difficulty
  cuisineId        String
  cuisine          Cuisine    @relation(fields: [cuisineId], references: [id])
  mealSlot         MealSlot[]
  effortTier       EffortTier
  batchFriendly    Boolean    @default(false)
  attributes       String[]   @default([])
  heroColor        String
  imageUrl         String?
  imageCredit      String?

  caloriesPerServing Int?
  proteinGrams       Int?
  carbsGrams         Int?
  fatGrams           Int?

  dietTags     Diet[]                 @relation("SubmissionDietTags")
  allergenTags Allergen[]             @relation("SubmissionAllergenTags")
  ingredients  SubmissionIngredient[]
  steps        SubmissionStep[]

  status           SubmissionStatus @default(PENDING)
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedById     String?
  approvedRecipeId String?          @unique
  approvedRecipe   Recipe?          @relation(fields: [approvedRecipeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model SubmissionIngredient {
  id           String           @id @default(cuid())
  submissionId String
  submission   RecipeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  component    String?
  order        Int
  quantity     String
  unit         String?
  item         String
  prepNote     String?
  optional     Boolean          @default(false)
}

model SubmissionStep {
  id              String           @id @default(cuid())
  submissionId    String
  submission      RecipeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  order           Int
  text            String
  durationMinutes Int?
}

// ---------- Behavioral log (append-only) ----------

model Interaction {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId       String
  recipe         Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  type           InteractionType
  createdAt      DateTime        @default(now())
  localHour      Int
  localDayOfWeek Int
  metadata       Json?

  @@index([userId, type, createdAt])
  @@index([recipeId, type])
}

model Cooldown {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId        String
  recipe          Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  suppressedUntil DateTime?
  reason          CooldownReason

  @@unique([userId, recipeId])
}

model CookLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedAt    DateTime @default(now())
  servings    Int
  isPublic    Boolean  @default(false)
  cosignNote  String?
}

// "Cook Later" — user-curated save list, capped at 10 per user (enforced in
// the API route, not the schema).
model SavedRecipe {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  savedAt  DateTime @default(now())

  @@unique([userId, recipeId])
}

// Admin-curated, named recipe collections (e.g. "Editor's Picks"), surfaced
// on the dashboard as highlighted rows — distinct from the per-user "Cook
// Book" (CookLog-based cooked-history) and from "Cook Later" (SavedRecipe).
model Cookbook {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  recipes   CookbookRecipe[]
}

model CookbookRecipe {
  id         String   @id @default(cuid())
  cookbookId String
  cookbook   Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([cookbookId, recipeId])
}

model ServedCard {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId       String
  recipe         Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  servedAt       DateTime @default(now())
  // Identifies the timezone-local meal-slot window this card was served for,
  // e.g. "2026-08-03:DINNER" (see src/lib/meal-slot.ts). Empty string on rows
  // created before this field existed — they simply never match a real
  // window key and become inert history, same as other append-only logs here.
  windowKey      String   @default("")
  scoreBreakdown Json?
  // 0-based position within its batch (same userId+windowKey+servedAt) —
  // added to make batch reads deterministic. Ties on servedAt (every row in
  // a batch is written with the same timestamp) have no defined order on
  // their own, so relying on servedAt alone let the same 4 served recipes
  // come back in a different order across requests (see DECISIONS.md /
  // the "recipes change on back navigation" fix). Defaults to 0 for legacy
  // rows pre-dating this field; backfilled properly by a follow-up
  // migration before the uniqueness constraint is added.
  position       Int      @default(0)

  @@index([userId, servedAt])
  @@index([userId, windowKey])
  @@unique([userId, windowKey, servedAt, position])
}
