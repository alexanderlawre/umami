    "steps": [
      {
        "order": 1,
        "text": "Poach the desalted salt cod in simmering water for 10 minutes until tender. Drain, cool slightly, and shred into bite-sized pieces, removing any bones or skin.",
        "durationMinutes": 15
      },
      {
        "order": 2,
        "text": "Heat half the olive oil in a large pan over medium-high heat. Fry the matchstick potatoes in batches until golden and crispy, about 5-7 minutes per batch. Drain on paper towels.",
        "durationMinutes": 15
      },
      {
        "order": 3,
        "text": "In the same pan with remaining oil, sauté the sliced onions over medium heat until soft and translucent, about 8 minutes. Add garlic and cook for another minute until fragrant.",
        "durationMinutes": 9
      },
      {
        "order": 4,
        "text": "Add the shredded cod to the onions and stir well. Cook for 3-4 minutes to allow flavors to meld.",
        "durationMinutes": 4
      },
      {
        "order": 5,
        "text": "Add the crispy potatoes to the pan and toss everything together. Pour in the beaten eggs and stir continuously over low heat until the eggs are just set but still creamy, about 2-3 minutes.",
        "durationMinutes": 3
      },
      {
        "order": 6,
        "text": "Remove from heat and season with black pepper. Garnish with black olives and fresh parsley. Serve immediately.",
        "durationMinutes": null
      }
    ],
